[Unit]
Description=Web Terminal Manager
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Workspace/web-terminal/server
EnvironmentFile=%h/Workspace/web-terminal/.env
ExecStart=/home/chamith/.nvm/versions/node/v24.16.0/bin/node dist/index.js
Restart=on-failure
RestartSec=2
# The tmux server is spawned as a descendant of this process and must survive
# service restarts/stops. KillMode=control-group (the default) would send the
# stop signal to every process in the service's cgroup, killing tmux and every
# session along with it. KillMode=process limits that to the main PID only.
KillMode=process

[Install]
WantedBy=default.target
